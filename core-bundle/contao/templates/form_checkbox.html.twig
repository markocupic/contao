{% extends '@Contao/form_row.html.twig' %}

{% block field %}
    {% set has_errors = hasErrors.invoke() %}
    {% set described_by = [has_errors ? "error_ctrl_#{this.id}", this.help|default ? "help_ctrl_#{this.id}"]|filter(id => id) %}

    <fieldset id="ctrl_{{ this.id }}" class="checkbox_container"{% if described_by is not empty %} aria-describedby="{{ described_by|join(' ') }}"{% endif %}>

        {% if this.label %}
            <legend>
                {% if this.mandatory|default %}
                    <span class="invisible">{{ this.mandatoryField }} </span>{{ this.label|insert_tag_html }}<span class="mandatory">*</span>
                {% else %}
                    {{ this.label|insert_tag_html }}
                {% endif %}
            </legend>
        {% endif %}

        {% if has_errors %}
            <p class="error" id="error_ctrl_{{ this.id }}">{{ getErrorAsString.invoke() }}</p>
        {% endif %}

        <input type="hidden" name="{{ this.name }}" value="">

        {% for option in getOptions.invoke() %}
            {% if option.type == 'group_start' %}
                <fieldset>
                <legend>{{ option.label }}</legend>
            {% endif %}

            {% if option.type == 'option' %}
                <span><input{{ attrs()
                        .set('type', 'checkbox')
                        .set('name', option.name)
                        .set('id', "opt_#{option.id}")
                        .addClass('checkbox')
                        .set('aria-invalid', 'true', has_errors)
                        .set('value', option.value)
                        .set('checked', option.checked, option.checked)
                        .mergeWith(option.attributes)
                    }}> <label id="lbl_{{ option.id }}" for="opt_{{ option.id }}">{{ option.label|sanitize_html('contao')|insert_tag_html }}</label></span>
            {% endif %}

            {% if option.type == 'group_end' %}
                </fieldset>
            {% endif %}
        {% endfor %}

        {% if this.help|default %}
            <p class="help" id="help_ctrl_{{ this.id }}">{{ this.help|insert_tag_html }}</p>
        {% endif %}

    </fieldset>
{% endblock %}
