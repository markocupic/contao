{% extends '@Contao/form_row.html.twig' %}

{% block label %}
    {% if this.label %}
        <label for="ctrl_{{ this.id }}">
            <span class="invisible">{{ this.mandatoryField }} </span>{{ this.label|insert_tag_html }}<span class="mandatory">*</span>
        </label>
    {% endif %}
{% endblock %}

{% block field %}
    {% set has_errors = hasErrors.invoke() %}
    {% if has_errors %}
        <p class="error" id="error_ctrl_{{ this.id }}">{{ getErrorAsString.invoke() }}</p>
    {% endif %}

    {% set input_attributes = attrs(getAttributes.invoke()) %}

    <input{{ attrs()
        .set('type', 'text')
        .set('name', this.name)
        .set('id', "ctrl_#{this.id}")
        .addClass('captcha mandatory')
        .set('aria-invalid', 'true', has_errors)
        .set('aria-describedby', has_errors ? "error_ctrl_#{this.id} captcha_text_#{this.id}" : "captcha_text_#{this.id}")
        .set('value', '')
        .mergeWith(input_attributes)
        .setIfExists('placeholder', input_attributes.placeholder|default|insert_tag)
    }}>
    <span id="captcha_text_{{ this.id }}" class="captcha_text">{{ getQuestion.invoke()|raw }}</span>
    <input type="hidden" name="{{ this.name }}_hash{{ has_errors ? 1 + this.sum ** 2 : '' }}" value="{{ has_errors ? getHash.invoke() : '' }}">

    {% if not has_errors %}
        <div style="{{ 'display:none'|csp_unsafe_inline_style }}">
            <label for="ctrl_{{ this.id }}_hp">Do not fill in this field</label>
            <input type="text" name="{{ this.name }}_name" id="ctrl_{{ this.id }}_hp" value="">
        </div>
        {% if not as_editor_view %}
            <script src="{{ getAjaxUrl.invoke() }}" data-id="{{ this.id }}" data-name="{{ this.name }}" async></script>
        {% endif %}
    {% endif %}

{% endblock %}
